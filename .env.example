# Environment Configuration for Nadi-9 Agent
# Provider mode: "mock" (default, runs fully offline without keys) or "openai" or "gemini"
LLM_PROVIDER=mock

# Model name when using live API
MODEL_NAME=gpt-4o-mini

# Optional API keys for live provider runs
OPENAI_API_KEY=
GEMINI_API_KEY=

# Budgets (per episode constraints)
MAX_MODEL_CALLS=25
MAX_TOOL_CALLS=50

# Database path
SQLITE_DB_PATH=data/processed/evidence_store.db
